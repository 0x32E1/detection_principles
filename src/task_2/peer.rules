# 1) HTTP
alert tcp any any -> any any (msg:"Malicious HTTP GET request to /malware (raw TCP)"; flow:to_server; content:"GET /malware HTTP/1.1"; sid:1000001; rev:1;)
# 2) DNS
alert udp any any -> any any (msg:"Malicious NDS query to malicious-domain.com"; dns.query; content:"malicious-domain.com"; sid:1000002; rev:1;)
# 3) TCP C2 handshake
alert tcp any any -> any any (msg:"Suspicious TCP C2 handshake detected"; content:"handshake"; sid:1000003; rev:1;)
# 4) ICMP tunneling activity
alert icmp any any -> any any (msg:"ICMP tunneling detected (ICMP_TUNNEL_123456)"; content:"ICMP_TUNNEL_123456"; sid:1000004; rev:1;)
